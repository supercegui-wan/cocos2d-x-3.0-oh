        "Box2dTestBedMain",
        "ChipmunkAccelTouchTestMain",
        "CurlTestMain",
        "MutiTouchTestMain",
        "SchdulerTestMain",
        "ShaderTestMain",
        "TextInputTestMain",
        "TextureCacheTestMain",
        "kmGLPushMatrix",
        "kmGLLoadMatrix",
        "kmGLPopMatrix",
        "PerformanceTest",
        "kItemTagBasic",
        "LuaObjcBridge",
        "LuaJavaBridge",
        "TriggerObj",
        "Color4B",
        "createDownloadDir",
        "deleteDownloadDir",
        "addSearchPath",
        "CreateExtensionsTestScene"
    ]
}